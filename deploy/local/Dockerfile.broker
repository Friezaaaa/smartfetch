FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN groupadd --gid 10001 smartfetch \
 && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin smartfetch \
 && mkdir -p /ipc \
 && chown -R 10001:10001 /ipc \
 && chmod 0700 /ipc

WORKDIR /app

COPY requirements.txt ./
RUN python -m pip install --no-cache-dir --upgrade pip==26.2.1 \
 && python -m pip install --no-cache-dir -r requirements.txt

COPY --chown=10001:10001 smartfetch ./smartfetch
COPY --chown=10001:10001 tests ./tests

USER 10001:10001

CMD ["python", "tests/browser_prototype_linux_gate.py", "broker"]
