# Production VPS Browser Worker Daemon Dockerfile
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/usr/local/bin:/usr/bin:/bin"

# Install Docker CLI and curl for healthchecks
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    docker-cli \
 && rm -rf /var/lib/apt/lists/*

# Create unprivileged smartfetch user and group (UID/GID 10001)
RUN echo "smartfetch:x:10001:10001::/home/smartfetch:/bin/bash" >> /etc/passwd \
 && echo "smartfetch:x:10001:" >> /etc/group \
 && mkdir -p /ipc /home/smartfetch /etc/smartfetch/certs \
 && chown -R 10001:10001 /ipc /home/smartfetch /etc/smartfetch

WORKDIR /app

COPY requirements.txt ./
RUN python -m pip install --no-cache-dir --upgrade pip==26.2.1 \
 && python -m pip install --no-cache-dir -r requirements.txt

COPY --chown=10001:10001 smartfetch ./smartfetch

USER 10001:10001

EXPOSE 8443

HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=3 \
  CMD curl -k -f --max-time 3 http://127.0.0.1:8443/health || curl -k -f --max-time 3 https://127.0.0.1:8443/health || exit 1

CMD ["python", "-m", "smartfetch.browser_daemon"]
