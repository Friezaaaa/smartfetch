# SmartFetch VPS Browser Worker Daemon Configuration Template
# Copy to .env on the VPS host: cp vps.env.example .env

# Mandatory: 32+ byte cryptographically random shared secret
# Generate with: openssl rand -hex 32
BROWSER_WORKER_HMAC_KEY=replace_with_64_character_hex_secret_generated_by_openssl

# Network binding
BROWSER_WORKER_HOST=0.0.0.0
BROWSER_WORKER_PORT=8443

# Resource and concurrency bounding
# On a 2 vCPU / 4GB VPS, 4 concurrent browsers is optimal (768MB RAM limit per worker)
BROWSER_WORKER_MAX_CONCURRENT=4

# Worker execution mode: 'docker' (recommended for VPS) or 'subprocess'
BROWSER_WORKER_MODE=docker
BROWSER_WORKER_DOCKER_IMAGE=smartfetch-browser-worker:prod
BROWSER_WORKER_SECCOMP=/etc/smartfetch/seccomp-chrome.json
BROWSER_WORKER_IPC_DIR=/ipc
BROWSER_WORKER_IPC_VOLUME=smartfetch_vps_ipc

# Host Docker group GID for container access to /var/run/docker.sock
# Defaults to 999 on Debian/Ubuntu; check host with: getent group docker | cut -d: -f3
DOCKER_GID=999

# Mutual TLS (mTLS) Certificates
# Mounted into the container at /etc/smartfetch/certs
BROWSER_WORKER_SSL_CERT=/etc/smartfetch/certs/server.crt
BROWSER_WORKER_SSL_KEY=/etc/smartfetch/certs/server.key
BROWSER_WORKER_SSL_CA=/etc/smartfetch/certs/ca.crt
