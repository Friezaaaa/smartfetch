# SmartFetch Railway Production Environment Configuration
# ==============================================================================
# Configure these variables in Railway Project Settings -> Variables
# to connect Railway API/MCP instances to the isolated VPS Browser Worker Daemon.
# ==============================================================================

# 1. VPS Browser Worker Connection (HTTPS + mTLS)
# The public or private IPv4/DNS endpoint of the VPS daemon.
BROWSER_WORKER_URL=https://worker.yourdomain.com:8443

# 2. Cryptographic Authentication (HMAC-SHA256)
# Must match the BROWSER_WORKER_HMAC_KEY on the VPS daemon.
# Generate via: openssl rand -hex 32
BROWSER_WORKER_HMAC_KEY=replace_with_64_character_hex_secret_matching_vps

# 3. Mutual TLS (mTLS) Certificate Credentials
# Required for zero-trust client identity verification at the network layer.
# In Railway, mount cert files or provide their filesystem paths.
BROWSER_WORKER_CA_CERT=/etc/smartfetch/certs/ca.crt
BROWSER_WORKER_CLIENT_CERT=/etc/smartfetch/certs/client.crt
BROWSER_WORKER_CLIENT_KEY=/etc/smartfetch/certs/client.key

# 4. Strict Security & Fail-Closed Enforcement
# Setting this to true guarantees that all browser render jobs fail closed if
# the isolated worker is unreachable, preventing any unisolated local fallback.
BROWSER_WORKER_REQUIRED=true

# 5. Operational Timeouts & Circuit Breaker Thresholds
BROWSER_WORKER_RENDER_TIMEOUT=30.0
BROWSER_WORKER_CONNECT_TIMEOUT=5.0
BROWSER_WORKER_CIRCUIT_FAILURE_THRESHOLD=5
BROWSER_WORKER_CIRCUIT_RECOVERY_SECONDS=30.0
